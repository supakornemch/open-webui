# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ── Environment ──
.env
.env.*
!.env.example
venv/
.venv/

# ── OS ──
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Local config / agent runtime ──
.zcode/
.agents/
.zcode-*

# ── Test artifacts ──
.playwright-mcp/

# ── Secrets (per-directory) ──
docker/.env

# ── Open WebUI local data ──
data/open-webui/

# ── POC exports (regenerable) ──
data/open_webui_poc.dump
data/open_webui_poc.sql

# ── IDE ──
.vscode/
.idea/
*.code-workspace
data/ingestion/
node_modules/

# ── Generated files ──
*.pptx
*.pdf

# ── Image files (except screenshots) ──
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico
*.svg
# Allow screenshots (needed by Docker build)
!screenshots/
!screenshots/*
