# ponytail: hardcode --platform because Azure App Service is Linux/AMD64.
# Local ARM Mac builds via docker buildx --platform linux/amd64 (Docker Desktop emulates).
# Updated to v0.11.0 (2026-08-05) — includes nginx 1.28.2+ (fixes CVE-2026-1642)
FROM --platform=linux/amd64 ghcr.io/open-webui/open-webui:v0.11.3

# ── Install Azure AI Search SDK for custom vector DB backend ──
RUN pip install --no-cache-dir azure-search-documents>=11.4.0

# ── Install pandas + openpyxl + httpx for Procurement Price Lookup Tool ──
RUN pip install --no-cache-dir pandas openpyxl httpx

# ── Install nginx 1.30+ from official repo + Fabric ODBC Driver 18 in one go ──
# Combine apt-get update to avoid overwriting sources.list
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg2 ca-certificates lsb-release debian-archive-keyring \
    && curl -fsSL https://nginx.org/keys/nginx_signing.key | gpg --dearmor -o /usr/share/keyrings/nginx-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] http://nginx.org/packages/debian $(lsb_release -cs) nginx" > /etc/apt/sources.list.d/nginx.list \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && apt-get install -y nginx \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pyodbc azure-identity

# ── Install black + click for code formatting ──
RUN pip install --no-cache-dir black click

# ── Pre-download sentence-transformers model to avoid runtime HF download ──
# VNet blocks outbound internet → model must be baked into the image
RUN python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# ── Teams SSO static files ──
COPY app/auth/teams-auth.html /app/build/teams-auth.html
COPY app/auth/teams-auth-bridge.html /app/build/teams-auth-bridge.html

# ── Static assets ──
COPY app/static/genie-setup-manual.html /app/build/docs/genie-setup-manual.html
COPY screenshots/ /app/build/screenshots/

# ── nginx reverse proxy ──
# Use conf.d instead of sites-enabled (more reliable across distros)
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/openwebui.conf

# ── Custom Azure AI Search vector DB backend ──
# Patches OWUI type.py + factory.py to register azure-ai-search
COPY app/patches/type.py /app/backend/open_webui/retrieval/vector/type.py
COPY app/patches/factory.py /app/backend/open_webui/retrieval/vector/factory.py
COPY app/patches/client.py /app/backend/open_webui/retrieval/vector/dbs/azure_ai_search.py

# ── Per-file embedding skip (SKIP_EMBEDDING_EXTENSIONS) ──
# In-place edit rather than COPY: retrieval.py is 3000+ lines of upstream code we
# don't want to vendor. Fails the build if the anchor moves on an OWUI upgrade.
COPY app/patches/skip_embedding.py /app/backend/open_webui/retrieval/skip_embedding.py
RUN RETRIEVAL=/app/backend/open_webui/routers/retrieval.py && \
    test "$(grep -c '^            if config.BYPASS_EMBEDDING_AND_RETRIEVAL:$' $RETRIEVAL)" = "1" && \
    sed -i 's|^            if config.BYPASS_EMBEDDING_AND_RETRIEVAL:$|            from open_webui.retrieval.skip_embedding import should_skip_embedding\n            if config.BYPASS_EMBEDDING_AND_RETRIEVAL or should_skip_embedding(file.filename):|' $RETRIEVAL && \
    grep -q 'should_skip_embedding(file.filename)' $RETRIEVAL && \
    python3 -c "import ast,sys; ast.parse(open('$RETRIEVAL').read())" && \
    echo "skip_embedding patch applied"

# ── Start nginx + Open WebUI (nginx on 8080 proxies to OWUI on 8081) ──
# Test nginx config before starting, and ensure it starts in foreground initially
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl --silent --fail http://localhost:8080/health | grep -qx 'OK'
CMD bash -c "nginx -t && nginx && echo 'nginx started on 8080' && PORT=8081 bash /app/backend/start.sh"
