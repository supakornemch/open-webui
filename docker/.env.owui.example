# Open WebUI — copy to docker/.env.owui and fill in secrets
#   cp docker/.env.owui.example docker/.env.owui

# ── Core ────────────────────────────────────────────────────
WEBUI_SECRET_KEY=change-me-in-production
WEBUI_AUTH=True
ENABLE_SIGNUP=True
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
ENABLE_API_KEY=true
ENABLE_API_KEYS=true

# Teams/SharePoint iframe embedding needs SameSite=none
WEBUI_SESSION_COOKIE_SAME_SITE=none
WEBUI_AUTH_COOKIE_SAME_SITE=none
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true

# ── Database ────────────────────────────────────────────────
# compose.yml overrides this for local runs. Must end in /open_webui.
DATABASE_URL=postgresql://user:pass@host:5432/open_webui?sslmode=require

# ── Microsoft Entra ID SSO ──────────────────────────────────
MICROSOFT_CLIENT_ID=your-entra-client-id
MICROSOFT_CLIENT_SECRET=your-entra-client-secret
MICROSOFT_CLIENT_TENANT_ID=your-entra-tenant-id
MICROSOFT_OAUTH_SCOPE="openid email profile offline_access"
OPENID_PROVIDER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration

# ── SharePoint Procurement master (Microsoft Graph) ─────────
# Set the source workbook location. The tool uses a per-user delegated token
# from Tool User Valves first, then SHAREPOINT_ACCESS_TOKEN, then app-only
# MICROSOFT_CLIENT_* credentials.
SHAREPOINT_SITE_HOST=yourtenant.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Procurement
SHAREPOINT_FILE_PATH=Shared Documents/Procurement/Procurement_Price_Template_v2.xlsx
# Optional short-lived delegated Microsoft Graph token. Do not commit a real value.
SHAREPOINT_ACCESS_TOKEN=

# ── Azure AI Foundry (OpenAI-compatible) ────────────────────
OPENAI_API_KEY=your-azure-foundry-key
OPENAI_API_VERSION=2024-12-01-preview

# ── Azure AI Search (custom vector DB backend) ──────────────
AZURE_SEARCH_ADMIN_KEY=your-azure-search-admin-key

# ── Azure Blob Storage ──────────────────────────────────────
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_STORAGE_KEY=your-storage-key
AZURE_STORAGE_CONTAINER_NAME=open-webui-files
AZURE_STORAGE_ENDPOINT=https://your-storage-account.blob.core.windows.net

# ── Document Intelligence (PDF extraction) ──────────────────
CONTENT_EXTRACTION_ENGINE=document_intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-ai-services.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=your-ai-services-key
DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read
