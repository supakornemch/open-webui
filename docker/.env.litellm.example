# LiteLLM — copy to docker/.env.litellm and fill in secrets
#   cp docker/.env.litellm.example docker/.env.litellm

# ── Proxy auth ──────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-your-litellm-master-key

# ── Model management ────────────────────────────────────────
# model_list is empty in litellm-config.yaml; models are added via /model/new
# or the UI, which both refuse to write unless this is set.
STORE_MODEL_IN_DB=true

# ── Database ────────────────────────────────────────────────
# LiteLLM runs `prisma migrate deploy` on this DB at startup. On a non-empty
# schema it auto-baselines and generates DROP TABLE for everything it doesn't
# own. Point it at a dedicated DB — never /open_webui.
DATABASE_URL=postgresql://user:pass@host:5432/litellm?sslmode=require

# ── Azure AI Foundry ────────────────────────────────────────
AZURE_API_KEY=your-azure-foundry-key
AZURE_API_BASE=https://your-ai-services.cognitiveservices.azure.com

# ── Microsoft Entra ID SSO (litellm-config.yaml sso_settings) ─
MICROSOFT_CLIENT_ID=your-entra-client-id
MICROSOFT_CLIENT_SECRET=your-entra-client-secret
MICROSOFT_TENANT=your-entra-tenant-id

# ── n8n Configuration (bundled inside LiteLLM image) ────────
N8N_ENCRYPTION_KEY=your-secret-n8n-encryption-key

